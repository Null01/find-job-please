
# ── [AMBOS] Django ───────────────────────────────────────────────────
# Genera una clave nueva por entorno (NO reuses la de dev en prod):
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=CHANGE_ME_clave_de_50+_caracteres
# LOCAL: 1   ·   PROD: 0  (nunca 1 con la app pública)
DJANGO_DEBUG=1
# LOCAL: localhost   ·   PROD: tu dominio (p. ej. find-job-please.onrender.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# ── [AMBOS] Negocio (prefijo BUSINESS_*) ─────────────────────────────
# Ranking del match: "embeddings" (semántico, ~1 GB de RAM) o "keyword" (léxico, liviano).
# En Render free/starter conviene "keyword" (embeddings exige mucha RAM/disco).
BUSINESS_RANKER_STRATEGY=embeddings
BUSINESS_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Pesos del híbrido semántico/léxico (opcionales; por defecto 0.8 / 0.2):
#BUSINESS_RANK_SEM_WEIGHT=0.8
#BUSINESS_RANK_LEX_WEIGHT=0.2


# ── [LOCAL] Postgres del docker-compose ──────────────────────────────
# Se usan SOLO cuando DATABASE_URL está vacía (desarrollo con el contenedor `db`).
POSTGRES_DB=findjob
POSTGRES_USER=findjob
POSTGRES_PASSWORD=CHANGE_ME_contraseña_larga_y_aleatoria


# ── [PROD] BD remota (Supabase) ──────────────────────────────────────
# NO pongas estos valores aquí: van en Infisical / variables de Render.
# Si DATABASE_URL está definida, la app la usa (con TLS) e IGNORA los POSTGRES_*.
# Supabase → Settings → Database → Connection string (URI) → "Session pooler" (5432).
#DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#DB_SSL_REQUIRE=1
# Solo si usas el pooler en modo transacción (puerto 6543):
#DB_POOLER_MODE=transaction


# ── [PROD] Almacenamiento de CVs — Cloudflare R2 (S3-compatible) ──────
# NO pongas estos valores aquí: van en Infisical / variables de Render.
# Si R2_BUCKET está definido, los CVs se guardan en R2 (persisten entre deploys);
# si no, se usan en disco local (desarrollo).
#R2_BUCKET=find-job-cvs
#R2_ACCESS_KEY_ID=<token de R2>
#R2_SECRET_ACCESS_KEY=<secreto de R2>
#R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
#R2_REGION=auto


# ── [PROD] Endurecimiento web (activo solo con DJANGO_DEBUG=0) ────────
# Orígenes https de confianza para CSRF (coma-separados):
#DJANGO_CSRF_TRUSTED_ORIGINS=https://find-job-please.onrender.com
# Redirección forzada a https (1 por defecto). Ponlo en 0 si el health check de
# Render falla por el redirect interno.
#DJANGO_SECURE_SSL_REDIRECT=1
