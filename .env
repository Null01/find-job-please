# Credenciales de la base de datos (Docker Compose las inyecta a ambos servicios).
# Cámbialas antes de desplegar a internet.
POSTGRES_DB=findjob
POSTGRES_USER=findjob
POSTGRES_PASSWORD=findjob_dev_pw

# Django
DJANGO_SECRET_KEY=dev-insecure-key-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Ranking del match: "embeddings" (local, semántico) o "keyword" (léxico simple).
# Cámbialo y reinicia el web para conectar/desconectar la estrategia.
RANKER_STRATEGY=embeddings
# Modelo de embeddings. base = buen balance; para máxima calidad: intfloat/multilingual-e5-large
EMBEDDING_MODEL=intfloat/multilingual-e5-base
